		battery3,q_max_table = <0x2430 0x2381 0x22CF 0x221C 0x2071>;

		/* 01 : ATL battery data */
		battery1,battery_type = <4420 0x23BE>; /* batt_v_max, cap */
		battery1,battery_table0 = <
			0x1400 0x1B82 0x1C44 0x1CC9 0x1D53 0x1D7A 0x1D89 0x1D93
