&sm5714_fuelgauge {
	battery_params {
		battery,id = <3>; /* default ID */
		/*
		 * BAT_ID_1/BAT_ID_2
		 * 11: SDI General Battery, 10: ATL Safety Battery
		 * 01: ATL General Battery, 00: TBD
		 */

		/* 11 : SDI battery data */
		battery3,battery_type = <4420 0x2430>; /* batt_v_max, cap */
		battery3,battery_table0 = <
			0x1400 0x1B1A 0x1C42 0x1CB7 0x1D18 0x1D5F 0x1D78 0x1D8F
			0x1DA5 0x1DE6 0x1E25 0x1E52 0x1E82 0x1EC4 0x1F22 0x1F56
